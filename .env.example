# ─────────────────────────────────────────────────────────────
# N인플 (naver-influencer) 환경변수 예시
# 실제 값은 Vercel Dashboard → Settings → Environment Variables
# 또는 로컬은 .env.local 에 설정합니다. 이 파일은 키 이름과 용도만 표시.
# ─────────────────────────────────────────────────────────────

# ─── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── 네이버 검색광고 API (키워드 검색량) ──────────────────────
# https://manage.searchad.naver.com → 도구 → API 관리
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# ─── 네이버 데이터랩 API ──────────────────────────────────────
# https://developers.naver.com/apps
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# ─── 네이버 검색 API ──────────────────────────────────────────
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ─── Vercel Cron 인증 ─────────────────────────────────────────
# /api/cron/* 엔드포인트는 Authorization: Bearer ${CRON_SECRET} 검증.
# 임의의 문자열(권장 64자 이상). verifyCronSecret() 에서 사용.
# GitHub Actions 에도 동일 값을 Repository secret CRON_SECRET 로 등록 (.github/GITHUB_ACTIONS_SECRETS.md)
CRON_SECRET=

# ─── 관리자 / 제한 사용자 ─────────────────────────────────────
# ADMIN_USER_IDS: users.id (콤마 구분)
# RESTRICTED_USER_EMAILS: 경쟁자 이메일 (콤마 구분)
ADMIN_USER_IDS=
RESTRICTED_USER_EMAILS=

# ─── Upstash Redis (Rate Limit 분산) ──────────────────────────
# 미설정 시 인메모리 fallback (단일 인스턴스 한정)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Resend (이메일 발송, 선택) ───────────────────────────────
RESEND_API_KEY=
# 발신자 주소. 미설정 시 기본값(코드 내) 사용.
RESEND_FROM_EMAIL=

# ─── 개인정보처리방침 이메일 (/api/cron/privacy-notices) ─────
# 방침 개정 시 버전만 올리면 해당 버전과 불일치한 회원에게 개정 안내 메일.
# ISO 날짜 문자열 권장(문자열 비교로 신·구 판별).
PRIVACY_POLICY_VERSION=2026-05-14
# 정기 안내 주기(개월). 기본 12 = 연 1회.
PRIVACY_NOTICE_REMINDER_MONTHS=12

# ─── PortOne V2 결제 (2026-05-03 재구성, 빌링키 정기결제) ────
# PortOne Console → 결제연동 → API 키
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 클라이언트 SDK 용 (NEXT_PUBLIC_* 은 빌드 시 번들에 포함됨)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# ─── Claude (Anthropic) API — 캐릭터챗북 / 블로그 AI 분석 ─────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Google Analytics 4 ──────────────────────────────────────
# https://analytics.google.com → 관리 → 데이터 스트림 → 측정 ID
# 미설정 시 GA 스크립트는 로드되지 않음 (no-op)
NEXT_PUBLIC_GA_ID=

# ─── 카카오 알림톡 (선택) ─────────────────────────────────────
# https://developers.kakao.com / 비즈톡 채널 등록 후 발급
KAKAO_REST_API_KEY=
KAKAO_SENDER_KEY=
KAKAO_RANK_TEMPLATE_CODE=

# ─── Firebase Cloud Messaging — 푸시 알림 (선택) ─────────────
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 비공개 키 생성
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── 네이버 스마트스토어 검색 (선택) ──────────────────────────
# https://commerce.naver.com / 커머스API 신청
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=

# ─── 사이트 URL (절대 경로 생성용) ────────────────────────────
# Resend 이메일·OG 메타 등에서 사용. 둘 다 설정 가능, 기본은 코드 내 fallback.
NEXT_PUBLIC_SITE_URL=https://ninfle.kr
NEXT_PUBLIC_BASE_URL=https://ninfle.kr

# ─── 푸터 등에 노출되는 고객 문의 이메일 (미설정 시 orange@orangelibrary.co.kr) ───
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── 푸터 등에 노출되는 운영 블로그 URL (미설정 시 https://blog.naver.com/orangelibrary) ───
NEXT_PUBLIC_CONTACT_BLOG_URL=

# ─── 데스크탑 앱 /download — GitHub Releases API (서버 프록시) ───
# 미설정 시 익명 한도(낮음). Fine-grained PAT 또는 classic token (읽기 전용).
GITHUB_TOKEN=
# 기본 orange0717/naver-influencer. 포크 등 다른 저장소면 owner/repo 형식.
GITHUB_RELEASE_REPO=
# GitHub API 실패 시 합성 URL에 쓸 태그 (기본: desktop-v + desktop/package.json 버전)
DESKTOP_RELEASE_TAG=
# 합성/태그 조회 시 버전 문자열 오버라이드 (예: 0.1.4). 미설정 시 desktop/package.json
DESKTOP_APP_VERSION=

# ─── 모바일 스토어 직접 링크 (선택, /download 모바일 카드) ───
# 예: https://apps.apple.com/kr/app/id0000000000
NEXT_PUBLIC_IOS_APP_STORE_URL=
# 예: https://play.google.com/store/apps/details?id=co.kr.ninfl.app
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=
