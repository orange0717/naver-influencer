# ─────────────────────────────────────────────────────────────
# N인플 (naver-influencer) 환경변수 예시
# 실제 값은 Vercel Dashboard → Settings → Environment Variables
# 또는 로컬은 .env.local 에 설정합니다. 이 파일은 키 이름과 용도만 표시.
# ─────────────────────────────────────────────────────────────

# ─── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── 네이버 검색광고 API (키워드 검색량) ──────────────────────
# https://manage.searchad.naver.com → 도구 → API 관리
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# ─── 네이버 데이터랩 API ──────────────────────────────────────
# https://developers.naver.com/apps
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# ─── 네이버 검색 API ──────────────────────────────────────────
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ─── 네이버 간편로그인 (OAuth 2.0) ───────────────────────────
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# ─── Vercel Cron 보호 ─────────────────────────────────────────
# 임의의 문자열(권장 64자 이상). verifyCronSecret 에서 확인.
CRON_SECRET=

# ─── 관리자 / 제한 사용자 ─────────────────────────────────────
# ADMIN_USER_IDS: users.id (콤마 구분)
# RESTRICTED_USER_EMAILS: 경쟁자 이메일 (콤마 구분)
ADMIN_USER_IDS=
RESTRICTED_USER_EMAILS=

# ─── Upstash Redis (Rate Limit 분산) ──────────────────────────
# 미설정 시 인메모리 fallback (단일 인스턴스 한정)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Resend (이메일 발송, 선택) ───────────────────────────────
RESEND_API_KEY=

# ─── PortOne V2 결제 (예정) ───────────────────────────────────
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# ─── Claude (Anthropic) API — 캐릭터챗북 / 블로그 AI 분석 ─────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Google Analytics 4 ──────────────────────────────────────
# https://analytics.google.com → 관리 → 데이터 스트림 → 측정 ID
# 미설정 시 GA 스크립트는 로드되지 않음 (no-op)
NEXT_PUBLIC_GA_ID=
