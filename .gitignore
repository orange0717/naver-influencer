# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local exports / packaged artifacts / private documents
*.zip
*.xlsx
*.docx
데이터랩툴즈(datalab.tools)-exports-*/
ziKjEvIt

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Capacitor native build artifacts
ios/App/Pods/
ios/DerivedData/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Electron desktop build artifacts
desktop/node_modules/
desktop/dist/
desktop/.cache/
# 빌드 시 생성되는 OS별 아이콘은 커밋하지 않음(원본 PNG만 유지)
desktop/icons/icon.icns
desktop/icons/icon.ico

# Repo-local side apps (venv + build output)
backend/.venv/
backend/.env
frontend/node_modules/
frontend/dist/
**/__pycache__/
*.py[cod]
