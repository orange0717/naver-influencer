{
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/api/cron/crawl-keywords",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/crawl-rankings",
      "schedule": "0 19 * * *"
    },
    {
