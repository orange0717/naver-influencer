    {
      "path": "/api/cron/refresh-stats",
      "schedule": "10 15 * * 0"
    },
    {
      "path": "/api/cron/charge-recurring",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/privacy-notices",
      "schedule": "15 4 * * *"
    }
