    },
    {
      "path": "/api/cron/crawl-blog-visitors",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/crawl-selection-dates",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/crawl-naver-mate",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/update-followers",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/demo-expiry",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "30 9 * * *"
